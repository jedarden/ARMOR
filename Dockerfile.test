# Test deployment image: compile the validated ARMOR server with the
# repository's release-image test gate.
FROM golang:1.25-alpine AS builder

WORKDIR /build

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Test gate: run go vet and unit tests before building
# Integration tests (tests/integration/) require build tags and credentials,
# and are automatically skipped by this gate.
RUN CGO_ENABLED=0 go vet ./... && CGO_ENABLED=0 go test ./... -short

ARG VERSION
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -X github.com/jedarden/armor/internal/version.Version=${VERSION}" -o /armor ./cmd/armor

FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /armor /armor

EXPOSE 9000 9001
ENTRYPOINT ["/armor"]
