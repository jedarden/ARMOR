# ARMOR production configuration template.
#
# Copy this file to .env in the repository root (next to compose.yaml), fill
# in the values, then:
#
#   docker compose --profile production up -d
#
# .env is git-ignored: values belong here and in your secrets manager, never
# in git. This template deliberately carries variable names only — see
# README.md "Required configuration" for the minimum set and
# docs/configuration.md for what each variable means.

# Image tag override (optional; compose.yaml defaults to the repo VERSION value)
#ARMOR_VERSION=

# B2 backend (required with the default ARMOR_BACKEND=b2)
ARMOR_B2_REGION=
ARMOR_B2_ACCESS_KEY_ID=
ARMOR_B2_SECRET_ACCESS_KEY=
ARMOR_BUCKET=

# Cloudflare read path (optional; unset means reads go to B2 directly and
# B2 egress applies)
ARMOR_CF_DOMAIN=

# Encryption (required; hex, 32 bytes = 64 characters)
ARMOR_MEK=

# Default client credential (required; full access to ARMOR_BUCKET)
ARMOR_AUTH_ACCESS_KEY=
ARMOR_AUTH_SECRET_KEY=
