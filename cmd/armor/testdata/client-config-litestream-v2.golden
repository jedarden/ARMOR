# Litestream configuration for ARMOR
# Add to litestream.yml or use as environment variables

# Litestream environment variables
LITESTREAM_ENDPOINT=http://armor.example.com:9000
LITESTREAM_REGION=us-east-1  # Required but unused by ARMOR

# Credentials
# Set these from your ARMOR_AUTH_ACCESS_KEY_ID and ARMOR_AUTH_SECRET_KEY
LITESTREAM_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
LITESTREAM_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# Or in litestream.yml:
dbs:
  - path: /path/to/db.sqlite
    replicas:
      - type: s3
        endpoint: http://armor.example.com:9000
        bucket: YOUR_BUCKET
        region: us-east-1
        access-key-id: YOUR_ACCESS_KEY_ID
        secret-access-key: YOUR_SECRET_ACCESS_KEY

# ARMOR format version 2: multipart upload constraints
# Litestream uploads WAL files as multipart uploads
# Default snapshot size is 4 MB which is below the 5 MB minimum
# Increase snapshot size to a block-aligned value:
#
# litestream.yml:
# dbs:
#   - path: /path/to/db.sqlite
#     snapshots:
#       - snapshot-interval: 1h
#         snapshot-size-mb: 64  # Block-aligned: 64 MB (multiple of 64 KB)
#
# Or via environment variable:
# export LITESTREAM_SNAPSHOT_SIZE_MB=64
