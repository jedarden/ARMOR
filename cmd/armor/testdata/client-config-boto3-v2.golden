# Boto3 configuration for ARMOR
# Python code example

import boto3
import os

# ARMOR endpoint configuration
endpoint_url = "http://localhost:9000"

# Credentials (set these environment variables)
# Using named credential: backup-writer
# Get these from your ARMOR deployment:
access_key = os.environ.get('AWS_ACCESS_KEY_ID')
secret_key = os.environ.get('AWS_SECRET_ACCESS_KEY')

# Create S3 client with path-style addressing
s3 = boto3.client('s3',
    endpoint_url=endpoint_url,
    aws_access_key_id=access_key,
    aws_secret_access_key=secret_key,
    region_name='us-east-1',  # Required but unused by ARMOR
    config=boto3.session.Config(s3={'addressing_style': 'path'})
)

