# Boto3 configuration for ARMOR
# Python code example

import boto3
import os

# ARMOR endpoint configuration
endpoint_url = "http://localhost:9000"

# Credentials (set these environment variables)
# Using named credential: backup-writer
# Get these from your ARMOR deployment:
access_key = os.environ.get('AWS_ACCESS_KEY_ID')
secret_key = os.environ.get('AWS_SECRET_ACCESS_KEY')

# Create S3 client with path-style addressing
s3 = boto3.client('s3',
    endpoint_url=endpoint_url,
    aws_access_key_id=access_key,
    aws_secret_access_key=secret_key,
    region_name='us-east-1',  # Required but unused by ARMOR
    config=boto3.session.Config(s3={'addressing_style': 'path'})
)

# Example usage
# bucket = "my-bucket"
# response = s3.list_objects_v2(Bucket=bucket)
# for obj in response.get('Contents', []):
#     print(obj['Key'])

# Multipart (write format v2, legacy; ADR-015): part 1 pins the uniform
# part size P; non-final parts must be exactly P, the final part any size.
# A part numbered >1 arriving before part 1 is deferred with retryable
# 503 SlowDown -- default client retry clears it. No tuning required.
# boto3's TransferConfig defaults work unmodified: parts upload concurrently out-of-order, and the SDK retries 5xx (which covers v2's SlowDown deferral).
# Tested compatibility matrix: docs/multipart-client-compatibility.md
